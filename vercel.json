{
  "version": 2,
  "builds": [
    {
      "src": "server.js",
      "use": "@vercel/node"
    }
  ],
  "functions": {
    "server.js": {
      "includeFiles": "package.json"
    }
  },
  "routes": [
    {
      "src": "/(.*)",
      "dest": "server.js",
      "headers": {
        "cache-control": "no-store, no-cache, must-revalidate, proxy-revalidate, max-age=0"
      }
    }
  ]
}
